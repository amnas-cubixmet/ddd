# Server-only environment variables; never commit .env.local.
SITE_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM_NAME="BHARAT LUMS"
SMTP_USER=
SMTP_APP_PASSWORD=
CONTACT_RECEIVER_EMAIL=
# Set SITE_URL to the verified website origin once this build is served there.
# Preview deployments and builds without SITE_URL are noindex.
# Set SITE_INDEXING=disabled on any additional staging environments.
# Optional ownership tokens for Search Console and Bing.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
